+fn spawn_config_watcher<W: notify::Watcher + 'static>(
     term: Arc<AtomicBool>,
     config: Arc<Mutex<Config>>,
     config_version: Arc<AtomicU64>,
@@ -1743,7 +1746,7 @@ fn spawn_config_watcher(
         let (fs_tx, fs_rx) = mpsc::sync_channel::<notify::Result<notify::Event>>(64);
         let overflow = Arc::new(AtomicBool::new(false));
         let overflow_clone = overflow.clone();
-        let mut watcher: notify::RecommendedWatcher = match notify::RecommendedWatcher::new(
+        let mut watcher: W = match W::new(
             move |event: notify::Result<notify::Event>| {
                 if event
                     .as_ref()
@@ -2222,7 +2225,7 @@ pub fn run() -> Result<()> {
     let _ = std::fs::remove_file(&sock_path);
     let server = SocketServer::bind(&sock_path)?;
 
-    let config_paths_tx = spawn_config_watcher(
+    let config_paths_tx = spawn_config_watcher::<notify::RecommendedWatcher>(
         term.clone(),
         config.clone(),
         config_version.clone(),
@@ -2743,6 +2746,91 @@ mod tests {
