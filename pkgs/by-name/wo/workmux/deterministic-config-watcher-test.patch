+    /// In-process stand-in for the OS watcher backend. Real backends deliver
+    /// events through shared OS machinery (FSEvents can lag by tens of seconds
+    /// under concurrent filesystem load), so the config watcher test drives
+    /// this instead. Like inotify and kqueue, a watch is bound to the
+    /// directory's identity: a replaced directory stops reporting until it is
+    /// watched again.
+    struct FakeWatcher;
+
+    #[derive(Default)]
+    struct FakeWatchState {
+        handler: Option<Box<dyn notify::EventHandler>>,
+        watches: HashMap<PathBuf, (u64, u64)>,
+        failed: Vec<PathBuf>,
+    }
+
+    static FAKE_WATCH: std::sync::LazyLock<Mutex<FakeWatchState>> =
+        std::sync::LazyLock::new(Mutex::default);
+
+    fn dir_identity(path: &Path) -> Option<(u64, u64)> {
+        use std::os::unix::fs::MetadataExt;
+        let metadata = std::fs::metadata(path).ok()?;
+        Some((metadata.dev(), metadata.ino()))
+    }
+
+    impl notify::Watcher for FakeWatcher {
+        fn new<F: notify::EventHandler>(
+            event_handler: F,
+            _config: notify::Config,
+        ) -> notify::Result<Self> {
+            FAKE_WATCH.lock().unwrap().handler = Some(Box::new(event_handler));
+            Ok(Self)
+        }
+
+        fn watch(&mut self, path: &Path, _recursive_mode: RecursiveMode) -> notify::Result<()> {
+            let mut state = FAKE_WATCH.lock().unwrap();
+            match dir_identity(path) {
+                Some(identity) => {
+                    state.watches.insert(path.to_path_buf(), identity);
+                    Ok(())
+                }
+                None => {
+                    state.failed.push(path.to_path_buf());
+                    Err(notify::Error::path_not_found().add_path(path.to_path_buf()))
+                }
+            }
+        }
+
+        fn unwatch(&mut self, path: &Path) -> notify::Result<()> {
+            FAKE_WATCH
+                .lock()
+                .unwrap()
+                .watches
+                .remove(path)
+                .map(|_| ())
+                .ok_or_else(notify::Error::watch_not_found)
+        }
+
+        fn kind() -> notify::WatcherKind {
+            notify::WatcherKind::NullWatcher
+        }
+    }
+
+    /// Writes `path` and reports it if its directory is watched under the
+    /// directory's current identity.
+    fn fake_watch_write(path: &Path, contents: &str) {
+        std::fs::write(path, contents).unwrap();
+        let dir = path.parent().unwrap();
+        let mut state = FAKE_WATCH.lock().unwrap();
+        if dir_identity(dir).is_some_and(|identity| state.watches.get(dir) == Some(&identity)) {
+            let event = notify::Event::new(notify::EventKind::Modify(
+                notify::event::ModifyKind::Data(notify::event::DataChange::Content),
+            ))
+            .add_path(path.to_path_buf());
+            state.handler.as_mut().unwrap().handle_event(Ok(event));
+        }
+    }
+
+    fn wait_for_fake_watch(what: &str, done: impl Fn(&FakeWatchState) -> bool) {
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !done(&FAKE_WATCH.lock().unwrap()) {
+            assert!(Instant::now() < deadline, "timed out waiting for {what}");
+            thread::sleep(Duration::from_millis(10));
+        }
+    }
+
     #[test]
     fn project_config_watcher_recovers_registration_and_directory_replacement() {
         const TEST: &str = "command::sidebar::daemon::tests::project_config_watcher_recovers_registration_and_directory_replacement";
@@ -2763,7 +2851,7 @@ mod tests {
         let term = Arc::new(AtomicBool::new(false));
         let version = Arc::new(AtomicU64::new(0));
         let (wake_tx, wake_rx) = mpsc::sync_channel(1);
-        let paths_tx = spawn_config_watcher(
+        let paths_tx = spawn_config_watcher::<FakeWatcher>(
             term.clone(),
             Arc::new(Mutex::new(Config::default())),
             version.clone(),
@@ -2772,35 +2860,40 @@ mod tests {
         );
         let desired = HashSet::from([dir.clone(), global_dir]);
         paths_tx.send(desired.clone()).unwrap();
-        // Allow the missing-directory registration attempt to fail.
-        thread::sleep(Duration::from_millis(700));
+        wait_for_fake_watch("missing directory registration to fail", |state| {
+            state.failed.contains(&dir)
+        });
         std::fs::create_dir(&dir).unwrap();
         paths_tx.send(desired.clone()).unwrap();
-        thread::sleep(Duration::from_millis(700));
+        wait_for_fake_watch("project directory watch", |state| {
+            state.watches.contains_key(&dir)
+        });
         let config_path = dir.join(".workmux.yaml");
-        std::fs::write(&config_path, "agent: first").unwrap();
+        fake_watch_write(&config_path, "agent: first");
         wake_rx.recv_timeout(Duration::from_secs(5)).unwrap();
         assert!(version.load(Ordering::Relaxed) > 0);
-        std::fs::write(dir.join("temporary"), "agent: atomic").unwrap();
-        std::fs::rename(dir.join("temporary"), &config_path).unwrap();
-        wake_rx.recv_timeout(Duration::from_secs(5)).unwrap();
-        std::fs::write(&config_path, "agent: after-atomic").unwrap();
-        wake_rx.recv_timeout(Duration::from_secs(5)).unwrap();
         std::fs::rename(&dir, temp.path().join("old-project")).unwrap();
         std::fs::create_dir(&dir).unwrap();
         paths_tx.send(desired).unwrap();
-        thread::sleep(Duration::from_millis(700));
-        while wake_rx.try_recv().is_ok() {}
+        wait_for_fake_watch("replaced directory watch", |state| {
+            state.watches.get(&dir).copied() == dir_identity(&dir)
+        });
         let before = version.load(Ordering::Relaxed);
-        std::fs::write(&config_path, "agent: after-directory-replacement").unwrap();
+        fake_watch_write(&config_path, "agent: after-directory-replacement");
         wake_rx.recv_timeout(Duration::from_secs(5)).unwrap();
         assert!(version.load(Ordering::Relaxed) > before);
         // Removing project membership must not remove the shared global watch.
-        paths_tx.send(HashSet::from([dir])).unwrap();
-        thread::sleep(Duration::from_millis(700));
-        while wake_rx.try_recv().is_ok() {}
+        // Paths are reconciled in order, so the removal has been applied once
+        // the follow-up watch of `other` exists.
+        let other = temp.path().join("other");
+        std::fs::create_dir(&other).unwrap();
+        paths_tx.send(HashSet::from([dir.clone()])).unwrap();
+        paths_tx.send(HashSet::from([dir, other.clone()])).unwrap();
+        wait_for_fake_watch("follow-up watch", |state| {
+            state.watches.contains_key(&other)
+        });
         let before = version.load(Ordering::Relaxed);
-        std::fs::write(global, "agent: global-reload").unwrap();
+        fake_watch_write(&global, "agent: global-reload");
         wake_rx.recv_timeout(Duration::from_secs(5)).unwrap();
         assert!(version.load(Ordering::Relaxed) > before);
         term.store(true, Ordering::Relaxed);
