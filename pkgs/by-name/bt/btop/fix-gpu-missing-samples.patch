+// SPDX-License-Identifier: Apache-2.0
+
+#include "btop_config.hpp"
+#include "btop_draw.hpp"
+#include "btop_shared.hpp"
+#include "btop_theme.hpp"
+#include "btop_tools.hpp"
+#include <gtest/gtest.h>
+
+#ifdef GPU_SUPPORT
+class GpuMissingSamples : public testing::TestWithParam<const char*> {
+protected:
+	Cpu::cpu_info cpu{};
+	std::vector<Gpu::gpu_info> gpus{1};
+
+	void SetUp() override {
+		Term::width = 160;
+		Term::height = 45;
+		Shared::coreCount = 12;
+		Runner::stopping = false;
+		Cpu::got_sensors = true;
+		Cpu::cpu_temp_only = true;
+		Cpu::cpuName = "Test CPU";
+		Cpu::available_fields = {"total", "gpu-totals"};
+		Config::set("show_gpu_info", "On"s);
+		Config::set("show_battery", false);
+		Config::set("show_cpu_freq", false);
+		Config::set("show_uptime", false);
+		Config::set("check_temp", true);
+		Theme::setTheme();
+		cpu.cpu_percent.at("total") = {25};
+		cpu.core_percent.resize(12, {25});
+		cpu.temp.resize(13, {50});
+		cpu.temp_max = 95;
+		Gpu::count = 1;
+		Gpu::gpu_names = {"Test GPU"};
+		Gpu::gpu_b_height_offsets = {8};
+		auto& gpu = gpus[0];
+		gpu.gpu_clock_speed = 1000;
+		gpu.pwr_usage = 3500;
+		gpu.pwr_state = 0;
+		gpu.mem_total = 8192;
+		gpu.mem_used = 4096;
+		gpu.temp = {45};
+		gpu.gpu_percent.at("gpu-totals") = {37};
+		gpu.gpu_percent.at("gpu-vram-totals") = {50};
+		gpu.gpu_percent.at("gpu-pwr-totals") = {18};
+		if (std::string_view(GetParam()) == "all") {
+			for (auto& [key, samples] : gpu.gpu_percent) samples.clear();
+			gpu.temp.clear();
+			gpu.mem_utilization_percent.clear();
+		} else {
+			gpu.gpu_percent.at(GetParam()).clear();
+		}
+	}
+
+	void collect_samples() {
+		gpus[0].gpu_percent.at("gpu-totals").push_back(73);
+		gpus[0].gpu_percent.at("gpu-vram-totals").push_back(50);
+		gpus[0].gpu_percent.at("gpu-pwr-totals").push_back(18);
+		gpus[0].temp.push_back(45);
+		gpus[0].mem_utilization_percent.push_back(20);
+	}
+};
+
+TEST_P(GpuMissingSamples, CpuPanelRecoversWhenSamplesArrive) {
+	Config::set("shown_boxes", "cpu"s);
+	Draw::calcSizes();
+	EXPECT_FALSE(Cpu::draw(cpu, gpus, true, false).empty());
+	collect_samples();
+	const auto drawn = Cpu::draw(cpu, gpus, false, false);
+	EXPECT_NE(drawn.find("GPU"), std::string::npos);
+	EXPECT_NE(drawn.find("73"), std::string::npos);
+}
+
+TEST_P(GpuMissingSamples, GpuPanelRecoversWhenSamplesArrive) {
+	Config::set("shown_boxes", "gpu0"s);
+	Draw::calcSizes();
+	EXPECT_FALSE(Gpu::draw(gpus[0], 0, true, false).empty());
+	collect_samples();
+	const auto drawn = Gpu::draw(gpus[0], 0, false, false);
+	EXPECT_NE(drawn.find("GPU"), std::string::npos);
+	EXPECT_NE(drawn.find("73"), std::string::npos);
+}
+
+INSTANTIATE_TEST_SUITE_P(Startup, GpuMissingSamples,
+	testing::Values("gpu-totals", "gpu-vram-totals", "gpu-pwr-totals", "all"));
+#endif
